+static int uniwill_platform_profile_probe(void *drvdata, unsigned long *choices)
+{
+	set_bit(PLATFORM_PROFILE_LOW_POWER, choices);
+	set_bit(PLATFORM_PROFILE_BALANCED, choices);
+	set_bit(PLATFORM_PROFILE_PERFORMANCE, choices);
+
+	return 0;
+}
+
+static int uniwill_platform_profile_hidden_choices(void *drvdata,
+						   unsigned long *choices)
+{
+	set_bit(PLATFORM_PROFILE_CUSTOM, choices);
+
+	return 0;
+}
+
+static int uniwill_platform_profile_get(struct device *dev,
+					enum platform_profile_option *profile)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, &value);
+	if (ret < 0)
+		return ret;
+
+	switch (value) {
+	case UNIWILL_PROFILE_LOW_POWER:
+		*profile = PLATFORM_PROFILE_LOW_POWER;
+		break;
+	case UNIWILL_PROFILE_BALANCED:
+		*profile = PLATFORM_PROFILE_BALANCED;
+		break;
+	case UNIWILL_PROFILE_PERFORMANCE:
+		*profile = PLATFORM_PROFILE_PERFORMANCE;
+		break;
+	default:
+		*profile = PLATFORM_PROFILE_CUSTOM;
+		break;
+	}
+
+	return 0;
+}
+
+static int uniwill_platform_profile_set(struct device *dev,
+					enum platform_profile_option profile)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+
+	switch (profile) {
+	case PLATFORM_PROFILE_LOW_POWER:
+		value = UNIWILL_PROFILE_LOW_POWER;
+		break;
+	case PLATFORM_PROFILE_BALANCED:
+		value = UNIWILL_PROFILE_BALANCED;
+		break;
+	case PLATFORM_PROFILE_PERFORMANCE:
+		value = UNIWILL_PROFILE_PERFORMANCE;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	return regmap_write(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, value);
+}
+
+static const struct platform_profile_ops uniwill_platform_profile_ops = {
+	.probe = uniwill_platform_profile_probe,
+	.hidden_choices = uniwill_platform_profile_hidden_choices,
+	.profile_get = uniwill_platform_profile_get,
+	.profile_set = uniwill_platform_profile_set,
+};
+
+static int uniwill_platform_profile_init(struct uniwill_data *data)
+{
+	if (!uniwill_device_supports(data, UNIWILL_FEATURE_PLATFORM_PROFILE))
+		return 0;
+
+	data->ppdev = devm_platform_profile_register(data->dev, "uniwill", data,
+						    &uniwill_platform_profile_ops);
+
+	return PTR_ERR_OR_ZERO(data->ppdev);
+}
